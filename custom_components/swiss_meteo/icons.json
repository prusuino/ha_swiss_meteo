{
  "triggers": {
    "rain_expected": {
      "trigger": "mdi:weather-rainy"
    },
    "rain_cleared": {
      "trigger": "mdi:weather-partly-cloudy"
    },
    "frost_expected": {
      "trigger": "mdi:snowflake-alert"
    },
    "new_forecast": {
      "trigger": "mdi:clock-check-outline"
    },
    "warning_issued": {
      "trigger": "mdi:alert"
    },
    "warning_cleared": {
      "trigger": "mdi:alert-circle-check-outline"
    },
    "rain_starting": {
      "trigger": "mdi:weather-pouring"
    },
    "rain_started": {
      "trigger": "mdi:weather-rainy"
    },
    "rain_stopped": {
      "trigger": "mdi:weather-cloudy"
    }
  },
  "conditions": {
    "is_rain_expected": {
      "condition": "mdi:weather-rainy"
    },
    "is_dry": {
      "condition": "mdi:weather-partly-cloudy"
    },
    "is_frost_expected": {
      "condition": "mdi:snowflake-alert"
    },
    "is_warning_active": {
      "condition": "mdi:alert"
    },
    "is_raining": {
      "condition": "mdi:weather-rainy"
    },
    "is_not_raining": {
      "condition": "mdi:weather-cloudy"
    },
    "is_rain_approaching": {
      "condition": "mdi:weather-pouring"
    }
  }
}
